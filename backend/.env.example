# ==============================================================================
# SCHOLARAi Backend Environment Configuration Template
# Block 4: Production Hardening, Real AI, Deployment & QA
# ==============================================================================

PROJECT_NAME="SCHOLARAi API"
ENVIRONMENT="development"  # Use 'production' for live deployments
DEBUG=True                 # Set to False in production
API_V1_STR="/api/v1"

# ------------------------------------------------------------------------------
# Database Configuration
# ------------------------------------------------------------------------------
# SQLite (default for local development & tests):
DATABASE_URL="sqlite:///./scholarai.db"

# PostgreSQL (recommended for production deployment on Render, Supabase, Neon, AWS RDS):
# DATABASE_URL="postgresql://postgres:your_password@db.example.com:5432/scholarai"
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20

# ------------------------------------------------------------------------------
# Authentication & Session Security
# ------------------------------------------------------------------------------
# In production, generate a secure 64-char key (e.g. `openssl rand -hex 32`):
AUTH_SECRET="dev-secret-key-change-in-production-scholarai-2026"
SESSION_COOKIE_NAME="scholarai_session"
SESSION_MAX_AGE_SECONDS=604800  # 7 days

# Demo Account Credentials (pre-seeded for local demonstration & tests):
DEMO_USER_EMAIL="demo@scholarai.local"
DEMO_USER_PASSWORD="DemoStudent@2026"

# ------------------------------------------------------------------------------
# AI Provider Configuration
# ------------------------------------------------------------------------------
# Supported providers:
#   - 'demo'               : Safe deterministic fallback, zero external API keys needed
#   - 'openai'             : OpenAI GPT models (e.g. gpt-4o, gpt-4o-mini)
#   - 'groq'               : Ultra-fast Llama/Mistral via Groq API
#   - 'gemini'             : Google Gemini via OpenAI-compatible endpoint
#   - 'openai_compatible'  : Any standard OpenAI-compatible API (Ollama, vLLM, DeepSeek)
AI_PROVIDER="demo"
AI_API_KEY=""
AI_MODEL="demo-scholar-v1"
AI_BASE_URL=""
AI_TIMEOUT_SECONDS=30.0

# ------------------------------------------------------------------------------
# CORS Allowed Origins
# ------------------------------------------------------------------------------
# Comma-separated list of allowed frontend origins (NO wildcard '*' in production):
CORS_ORIGINS="http://localhost:3000,http://127.0.0.1:3000"
